{$DOMAIN: :8080} {
    # VLESS WebSocket Path (Port 10000)
    @vless_ws {
        header Connection *Upgrade*
        header Upgrade websocket
        path /vless-ws
    }
    reverse_proxy @vless_ws 127.0.0.1:10000 {
        # Gi-extend ang timeouts para sa video streaming / large uploads
        transport http {
            read_timeout 1h
            write_timeout 1h
            dial_timeout 30s
        }
    }

    # Trojan WebSocket Path (Port 20000)
    @trojan_ws {
        header Connection *Upgrade*
        header Upgrade websocket
        path /trojan-ws
    }
    reverse_proxy @trojan_ws 127.0.0.1:20000 {
        transport http {
            read_timeout 1h
            write_timeout 1h
            dial_timeout 30s
        }
    }

    # Decoy Response
    respond "Service Running" 200

    # Compression
    encode gzip zstd
}
