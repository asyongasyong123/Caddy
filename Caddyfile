:8080 {
    @vless_ws {
        header Connection *Upgrade*
        header Upgrade websocket
        path /vless-ws
    }
    reverse_proxy @vless_ws 127.0.0.1:10000 {
        transport http {
            read_timeout 2h
            write_timeout 2h
        }
    }

    @trojan_ws {
        header Connection *Upgrade*
        header Upgrade websocket
        path /trojan-ws
    }
    reverse_proxy @trojan_ws 127.0.0.1:20000 {
        transport http {
            read_timeout 2h
            write_timeout 2h
        }
    }

    respond "Service Running Normal" 200
}
